# Fork extension layer — Python 3 + uv for marketplace plugin scripts.
#
# Builds on top of the upstream nanoclaw-agent-base image so this file never
# conflicts with upstream Dockerfile changes. To add or change fork-specific
# packages, edit this file only.
#
# Built automatically by build.sh when this file is present.

ARG BASE_IMAGE=nanoclaw-agent-base:latest
ARG UV_VERSION=0.7.19

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-bin
FROM ${BASE_IMAGE}

USER root

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv-bin /uv /usr/local/bin/uv

# Shared venv for marketplace Python scripts. Debian's PEP 668 marks the system
# Python as "externally managed", so a dedicated venv avoids that restriction.
# Common deps pre-installed here avoid cold-start latency on first MCP call.
ENV VIRTUAL_ENV=/opt/marketplace-pyenv
RUN uv venv $VIRTUAL_ENV && \
    uv pip install --python $VIRTUAL_ENV --no-cache \
        "mcp>=1.2.0" \
        "httpx>=0.27.0" \
        "markdown>=3.0.0" \
        "pydantic>=2.0.0" \
        "pydantic-settings>=2.0.0" \
        "jinja2>=3.1.6"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Redirect uv project envs to the persistent agent workspace so venvs survive
# container restarts (created once under the RW group mount, not rebuilt each time).
ENV UV_PROJECT_ENVIRONMENT=/workspace/agent/.uv-envs

USER node
