{
  "bridge": {
    "port": 13337,
    "certsDir": "~/.certs"
  },
  "marketplace": {
    "plugins": [
      {
        "name": "platform-common",
        "dir": "plugins/platform-common",
        "installMcpServers": true,
        "installSkills": true,
        "installAgents": false
      },
      {
        "name": "sdlc",
        "dir": "plugins/sdlc",
        "installMcpServers": true,
        "installSkills": true,
        "installAgents": true
      }
    ]
  },
  "servers": [
    {
      "name": "jira",
      "plugin": "platform-common",
      "command": "bash",
      "args": [
        "plugins/marketplace/plugins/platform-common/scripts/run-uv.sh",
        "--directory",
        "plugins/marketplace/plugins/platform-common/servers/jira-mcp",
        "run",
        "jira-mcp"
      ]
    },
    {
      "name": "bitbucket",
      "plugin": "platform-common",
      "command": "bash",
      "args": [
        "plugins/marketplace/plugins/platform-common/scripts/run-uv.sh",
        "--directory",
        "plugins/marketplace/plugins/platform-common/servers/bitbucket-mcp",
        "run",
        "bitbucket-mcp"
      ]
    },
    {
      "name": "confluence",
      "plugin": "platform-common",
      "command": "bash",
      "args": [
        "plugins/marketplace/plugins/platform-common/scripts/run-uv.sh",
        "--directory",
        "plugins/marketplace/plugins/platform-common/servers/confluence-mcp",
        "run",
        "confluence-mcp"
      ]
    },
    {
      "name": "sdlc-report",
      "plugin": "sdlc",
      "command": "bash",
      "args": [
        "plugins/marketplace/plugins/sdlc/scripts/run-uv.sh",
        "--directory",
        "plugins/marketplace/plugins/sdlc/servers/sdlc-report-mcp",
        "run",
        "sdlc-report-mcp"
      ]
    }
  ]
}
